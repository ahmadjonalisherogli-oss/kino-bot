# Telegram Bot Configuration
BOT_TOKEN=1234567890:REPLACE_WITH_REAL_BOT_TOKEN
BOT_USERNAME=your_cinema_bot
TELEGRAM_ADMIN_IDS=123456789,987654321
# Optional private log/archive channel ID used for silent post-availability verification
VERIFICATION_CHAT_ID=-1001234567890

# Django Security
DJANGO_SECRET_KEY=replace-with-a-64-char-cryptographic-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,cinema.example.com
CSRF_TRUSTED_ORIGINS=https://cinema.example.com

# PostgreSQL Database
POSTGRES_DB=telegram_cinema
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cinema_user:replace_with_strong_postgres_password@postgres:5432/telegram_cinema

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Logging & Rate Limiting
LOG_LEVEL=INFO
JSON_LOGS=True
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
